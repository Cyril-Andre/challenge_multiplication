{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flutter: Test Coverage",
      "type": "shell",
      "command": "fvm",
      "args": [
        "flutter",
        "test",
        "--coverage"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Coverage: HTML Report",
      "type": "shell",
      "command": "genhtml",
      "args": [
        "coverage/lcov.info",
        "--output-directory",
        "coverage/html"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Coverage: Full Report",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Flutter: Test Coverage",
        "Coverage: HTML Report"
      ],
      "group": "test",
      "problemMatcher": []
    }
  ]
}
